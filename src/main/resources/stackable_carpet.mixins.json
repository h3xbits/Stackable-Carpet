{
  "required": true,
  "minVersion": "0.8",
  "package": "com.h3xbit.stackablecarpet.mixin",
  "compatibilityLevel": "JAVA_25",
  "mixins": [
    "CarpetStackMixin",
    "PaleMossCarpetMixin",
    "MixedCarpetPickMixin"
  ],
  "client": [
    "CarpetOutlineMixin"
  ],
  "injectors": {
    "defaultRequire": 1
  },
  "overwrites": {
    "requireAnnotations": true
  }
}
